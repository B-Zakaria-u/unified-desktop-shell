{
    "name": "unified-desktop-shell",
    "version": "1.0.0",
    "description": "Unified Shell for AI Apps",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "electron:dev": "concurrently \"vite\" \"npm run dev --prefix ../course-rag-client\" \"npm run dev --prefix ../react-client\" \"wait-on tcp:5173 tcp:5174 tcp:5175 && cross-env NODE_ENV=development electron .\"",
        "build:all": "node scripts/build.cjs",
        "electron:build": "npm run build:all && npx electron-builder"
    },
    "build": {
        "appId": "com.unified.shell",
        "productName": "My AI Apps",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*"
        ],
        "win": {
            "target": "nsis"
        },
        "asarUnpack": [
            "dist/**/*"
        ]
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "electron-serve": "^1.3.0",
        "firebase": "^12.7.0",
        "lucide-react": "^0.292.0",
        "nodemailer": "^6.9.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "serve-handler": "^6.1.6"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.18",
        "@types/dotenv": "^6.1.1",
        "@vitejs/plugin-react": "^4.2.0",
        "autoprefixer": "^10.4.23",
        "concurrently": "^8.2.2",
        "cross-env": "^7.0.3",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "fs-extra": "^11.2.0",
        "postcss": "^8.4.49",
        "tailwindcss": "^4.1.18",
        "vite": "^5.0.0",
        "wait-on": "^7.2.0"
    }
}